# Copy to .env or export manually before running experiments/run_operation_dulce_eval.py

NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=<your password>
NEO4J_DATABASE=neo4j

# Fulltext index to query with the default retrieval Cypher.
NEO4J_FULLTEXT_INDEX=chunk_fulltext
NEO4J_TOP_K=5

# Optional: override with your own retrieval query if your schema differs.
# NEO4J_RETRIEVAL_CYPHER=CALL db.index.fulltext.queryNodes($index_name, $question) YIELD node, score RETURN node.text AS chunk, score ORDER BY score DESC LIMIT $top_k

PROJECT_NAME=
PROJECT_ID=

